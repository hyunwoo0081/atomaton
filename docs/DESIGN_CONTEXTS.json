{
  "project_name": "atomaton",
  "architecture_pattern": "Node-based Workflow Engine (Monorepo)",
  "data_flow": {
    "entry_point": "Triggers (IMAP/Webhook)",
    "execution_id": "UUID v4",
    "context_object": "WorkflowContext",
    "variable_syntax": "{{variable_name}}"
  },
  "workflow_context_structure": {
    "workflowId": "string",
    "triggerId": "string",
    "executionId": "string",
    "data": "Record<string, unknown> (Directly accessible via {{key}})",
    "results": "Record<string, unknown> (Nested execution results from nodes)"
  },
  "node_types": {
    "triggers": [
      {
        "type": "trigger-webhook",
        "description": "Receives JSON payload via POST with optional IP/Origin source whitelisting",
        "config_fields": [
          "apiKey",
          "samplePayload",
          "allowedIps",
          "allowedOrigins"
        ]
      }
    ],
    "actions": [
      {
        "type": "action",
        "label": "Discord Webhook",
        "config_fields": ["webhookUrl", "content"]
      },
      {
        "type": "action-notion",
        "label": "Notion Integration",
        "config_fields": ["databaseId", "properties"]
      },
      {
        "type": "action-http",
        "label": "Generic HTTP Request",
        "config_fields": ["method", "url", "headers", "body", "responseMapping"]
      },
      {
        "type": "action-regex-replace",
        "label": "Regex Replace",
        "config_fields": ["inputText", "rules", "outputVariable"]
      },
      {
        "type": "action-google-bridge",
        "label": "Google Bridge",
        "config_fields": ["webAppUrl", "action", "payload"]
      },
      {
        "type": "action-url-decode",
        "label": "URL Decode",
        "config_fields": ["inputText", "outputVariable"]
      },
      {
        "type": "action-ai",
        "label": "AI Generation (LLM)",
        "config_fields": [
          "baseUrl",
          "apiKey",
          "model",
          "systemPrompt",
          "prompt",
          "temperature",
          "responseFormat",
          "outputVariable",
          "customHeaders"
        ]
      }
    ],
    "logic": [
      {
        "type": "condition",
        "label": "Logical Condition (AND/OR)",
        "config_fields": ["logicType", "conditions"]
      },
      {
        "type": "condition-ai",
        "label": "AI Condition (LLM)",
        "config_fields": [
          "baseUrl",
          "apiKey",
          "model",
          "systemPrompt",
          "inputText",
          "criteria",
          "reasoningVariable",
          "customHeaders"
        ]
      }
    ]
  },
  "variable_mapping_rules": {
    "extraction_utility": "resolvePath(obj, path)",
    "merging_logic": "HTTP responseMapping, Regex outputVariable, URL decode outputVariable, and AI output/reasoning variables are merged directly into currentContext.data."
  }
}
